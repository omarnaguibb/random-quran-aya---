@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Noto+Naskh+Arabic:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,500;0,600;1,500&display=swap');

:root {
  color-scheme: light;
  --bg: #f7f2e9;
  --bg-strong: #ecdfc0;
  --card: rgba(255, 255, 255, 0.6);
  --ink: #183b35;
  --muted: #64756d;
  --green: #0c3b37;
  --gold: #c89a4a;
  --line: #d9d1bf;
  --shadow: 0 18px 50px rgba(18, 48, 43, 0.12);
}

* {
  box-sizing: border-box;
}

body {
  margin: 0;
  min-height: 100vh;
  color: var(--ink);
  font-family: 'DM Sans', sans-serif;
  background:
    radial-gradient(circle at top right, rgba(200, 154, 74, 0.18), transparent 25%),
    linear-gradient(180deg, var(--bg) 0%, #f3ebdf 100%);
}

button,
input,
textarea,
select {
  font: inherit;
}

.app-shell {
  width: min(100% - 1.5rem, 760px);
  min-height: 100vh;
  margin: 0 auto;
  padding: clamp(2.2rem, 6vh, 5rem) 0 2.5rem;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.topbar {
  text-align: center;
  margin-bottom: 1.8rem;
}

.brand-mark {
  color: var(--gold);
  font-size: 2.4rem;
  line-height: 1;
  margin-bottom: 0.75rem;
}

.eyebrow {
  margin: 0;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  font-size: 0.7rem;
  color: var(--muted);
}

h1 {
  margin: 0.6rem 0 0.3rem;
  font-size: clamp(2.2rem, 5vw, 3.5rem);
  font-weight: 700;
  letter-spacing: -0.06em;
  color: var(--green);
}

.tagline {
  margin: 0;
  color: var(--muted);
  font-size: 0.95rem;
}

.ayah-card {
  position: relative;
  width: 100%;
  padding: 1.5rem 1.2rem 2.2rem;
  border: 1px solid var(--line);
  border-radius: 28px;
  background: rgba(255, 255, 255, 0.58);
  box-shadow: var(--shadow);
  backdrop-filter: blur(8px);
  text-align: center;
}

.meta-row {
  display: flex;
  justify-content: space-between;
  gap: 0.75rem;
  margin-bottom: 0.75rem;
}

.info-chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 0.45rem 0.75rem;
  border-radius: 999px;
  background: rgba(12, 59, 55, 0.06);
  border: 1px solid rgba(12, 59, 55, 0.12);
  color: var(--green);
  font-size: 0.75rem;
  font-weight: 600;
}

.ornament {
  color: var(--gold);
  font-size: 1.7rem;
  margin-bottom: 0.85rem;
}

.arabic {
  margin: 0;
  font-family: 'Noto Naskh Arabic', serif;
  font-size: clamp(2.1rem, 6vw, 4rem);
  line-height: 1.75;
  direction: rtl;
  color: var(--green);
}

.rule {
  width: 110px;
  height: 3px;
  margin: 1.1rem auto 1.15rem;
  background: linear-gradient(90deg, transparent 0%, var(--gold) 50%, transparent 100%);
  border-radius: 999px;
}

.translation {
  margin: 0;
  font-size: clamp(1.05rem, 2vw, 1.4rem);
  line-height: 1.7;
  color: #3e4f49;
  font-family: 'Playfair Display', serif;
}

.reference {
  margin: 1rem 0 0;
  font-weight: 700;
  letter-spacing: 0.08em;
  color: var(--gold);
  text-transform: uppercase;
  font-size: 0.8rem;
}

.tafsir-card {
  width: 100%;
  margin-top: 1.2rem;
  border: 1px solid var(--line);
  border-radius: 18px;
  background: rgba(255, 255, 255, 0.4);
  overflow: hidden;
}

.tafsir-card summary {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
  padding: 1rem 1.1rem;
  cursor: pointer;
  list-style: none;
  color: var(--green);
  font-weight: 700;
}

.tafsir-card summary::-webkit-details-marker {
  display: none;
}

.tafsir-card summary span {
  color: var(--muted);
  font-weight: 600;
}

.tafsir-card p {
  margin: 0;
  padding: 0 1.1rem 1.1rem;
  color: #2d403d;
  line-height: 1.85;
  font-size: 1rem;
  direction: rtl;
  text-align: right;
}

.actions {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 0.8rem;
  width: 100%;
  margin-top: 1.3rem;
}

button {
  appearance: none;
  border: 1px solid transparent;
  border-radius: 16px;
  min-height: 52px;
  padding: 0.8rem 1rem;
  cursor: pointer;
  transition: transform 0.2s ease, box-shadow 0.2s ease, opacity 0.2s ease;
  font-weight: 700;
}

button:hover:not(:disabled) {
  transform: translateY(-1px);
}

button:disabled {
  opacity: 0.6;
  cursor: not-allowed;
}

.primary {
  background: linear-gradient(135deg, var(--green) 0%, #154d4b 100%);
  color: white;
  box-shadow: 0 10px 24px rgba(12, 59, 55, 0.2);
}

.secondary {
  background: rgba(12, 59, 55, 0.06);
  border-color: rgba(12, 59, 55, 0.12);
  color: var(--green);
}

.ghost {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background: transparent;
  border-color: rgba(12, 59, 55, 0.18);
  color: var(--green);
}

.utility-row {
  width: 100%;
  display: flex;
  justify-content: flex-end;
  margin-top: 0.8rem;
}

.status {
  min-height: 1.5rem;
  margin: 0.8rem 0 0;
  color: #556b63;
  text-align: center;
  font-size: 0.9rem;
}

.footnote {
  margin: 1rem 0 0;
  color: var(--muted);
  font-size: 0.78rem;
  text-align: center;
}

@media (max-width: 520px) {
  .actions {
    grid-template-columns: 1fr;
  }

  .ayah-card {
    padding: 1.2rem 1rem 1.7rem;
  }

  .meta-row {
    flex-direction: column;
    align-items: center;
  }
}
